# Copy to server/.env for local development.
MONGO_URL=mongodb://127.0.0.1:27017/leadflow
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Optional: AI lead scoring and email drafts with Claude. Without it, a transparent rule engine is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Set to false to stop public sign-ups (the first account becomes admin).
ALLOW_REGISTRATION=true
